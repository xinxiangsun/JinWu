# === Hidden folders (any depth) ===
# Covers .venv/, .idea/, .zcode/, .agents/, .codex/, .github/, .mimosa/,
# .hermes/, .runtime/, .pytest_cache/, etc. Tracked files inside them
# (e.g. .github/workflows/*.yml) stay tracked; gitignore never untracks.
.*/

# === Python ===
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg

# === Rust (jinwurs) ===
packages/jinwurs/target/
packages/jinwurs/Cargo.lock

# === Build & Distribution ===
build/
dist/
*.whl
*.tar.gz

# === Virtual Environments ===
venv/
env/

# === Sphinx Documentation ===
docs/_build/
docs/api/
docs/**/*.automodapi

# === Testing & Coverage ===
.coverage
htmlcov/
*.prof

# === macOS / editor droppings ===
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
*.swp

# === Environment & Logs ===
.env
*.log

# === External Dependencies (large / not in repo) ===
external_sources/

# === Local test & review trees (top-level only) ===
# Tracked copies (test suite, reviews evidence) remain tracked until
# explicitly removed with git rm --cached.
/test/
/tests/
/testrs/
/reviews/
