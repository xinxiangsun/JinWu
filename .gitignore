# === Hidden folders (any depth) ===
# Covers .venv/, .idea/, .zcode/, .agents/, .codex/, .github/, .mimosa/,
# .hermes/, .runtime/, .pytest_cache/, etc. Tracked files inside them
# (e.g. .github/workflows/*.yml) stay tracked; gitignore never untracks.
.*/

# === Python ===
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg

# === Rust (jinwurs) ===
packages/jinwurs/target/
packages/jinwurs/Cargo.lock

# === Build & Distribution ===
build/
dist/
*.whl
*.tar.gz

# === Virtual Environments ===
venv/
env/

# === Sphinx Documentation ===
docs/_build/
docs/api/
docs/**/*.automodapi

# === Testing & Coverage ===
.coverage
htmlcov/
*.prof

# === macOS / editor droppings ===
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
*.swp

# === Environment & Logs ===
.env
*.log

# === External Dependencies (large / not in repo) ===
external_sources/

# === Local test trees (tracked CI tests remain in Git) ===
/test/
/tests/
/testrs/

# === Private analysis, examples and development records ===
# Ignore rules do not remove already tracked files; use git rm --cached.
/local_private/
examples/
example/
*.ipynb
artifacts/
reviews/
scripts/
/conda-pypi-output/
/implementation_plan.md
/ARCHITECTURE_ROADMAP.md
VALIDATION.md

# Inactive legacy translation cache; current handbook is maintained directly.
/docs/locale/
*.mo
